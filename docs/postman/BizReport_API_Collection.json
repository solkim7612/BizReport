{
  "info": {
    "_postman_id": "bizreport-api-collection",
    "name": "BizReport API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "1234567890",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Business (사업자 관리)",
      "item": [
        {
          "name": "사업자 등록",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"1234567890\",\n  \"nm\": \"홍길동 상점\",\n  \"taxType\": \"GENERAL\",\n  \"indCd\": \"522005\",\n  \"indNm\": \"한식 면 요리 전문점\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/business",
              "host": ["{{baseUrl}}"],
              "path": ["business"]
            }
          }
        },
        {
          "name": "사업자 등록 확인",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/business/check/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["business", "check", "{{userId}}"]
            }
          }
        },
        {
          "name": "사업자 정보 조회",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/business/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["business", "{{userId}}"]
            }
          }
        },
        {
          "name": "사업자 정보 수정",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nm\": \"홍길동 맛집\",\n  \"taxType\": \"SIMPLIFIED\",\n  \"indCd\": \"522005\",\n  \"indNm\": \"한식 면 요리 전문점\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/business/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["business", "{{userId}}"]
            }
          }
        },
        {
          "name": "리포트 갱신권 충전",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/business/charge/refresh?id={{userId}}&count=5",
              "host": ["{{baseUrl}}"],
              "path": ["business", "charge", "refresh"],
              "query": [
                { "key": "id", "value": "{{userId}}" },
                { "key": "count", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "사업자 정보 변경이력 조회",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/business/history/biz/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["business", "history", "biz", "{{userId}}"]
            }
          }
        },
        {
          "name": "갱신권 변경이력 조회",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/business/history/refresh/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["business", "history", "refresh", "{{userId}}"]
            }
          }
        },
        {
          "name": "업종명 기반 검색",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/business/search/indNm?keyword=한식",
              "host": ["{{baseUrl}}"],
              "path": ["business", "search", "indNm"],
              "query": [
                { "key": "keyword", "value": "한식" }
              ]
            }
          }
        },
        {
          "name": "업종코드 기반 검색",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/business/search/indCd?keyword=522005",
              "host": ["{{baseUrl}}"],
              "path": ["business", "search", "indCd"],
              "query": [
                { "key": "keyword", "value": "522005" }
              ]
            }
          }
        },
        {
          "name": "업종별 세율 업로드 (CSV)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/your/rate.csv"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/business/upload/rate",
              "host": ["{{baseUrl}}"],
              "path": ["business", "upload", "rate"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Data (세무 데이터 관리)",
      "item": [
        {
          "name": "세무 데이터 조회",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/data/{{userId}}?startMon=2026-01&endMon=2026-12&type=ALL&method=ALL",
              "host": ["{{baseUrl}}"],
              "path": ["data", "{{userId}}"],
              "query": [
                { "key": "startMon", "value": "2026-01" },
                { "key": "endMon", "value": "2026-12" },
                { "key": "type", "value": "ALL" },
                { "key": "method", "value": "ALL" }
              ]
            }
          }
        },
        {
          "name": "세무 데이터 수기 추가",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendorId\": \"1234567890\",\n  \"transDt\": \"2026-03-10\",\n  \"totalPrice\": 110000,\n  \"vatValue\": 10000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/data/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["data", "{{userId}}"]
            }
          }
        },
        {
          "name": "영수증 텍스트 추출 (OCR)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/receipt.jpg"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/data/extract/text/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["data", "extract", "text", "{{userId}}"]
            }
          }
        },
        {
          "name": "세무 데이터 금액 수정",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vatValue\": 15000,\n  \"totalPrice\": 165000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/data/{{userId}}/1",
              "host": ["{{baseUrl}}"],
              "path": ["data", "{{userId}}", "1"]
            }
          }
        },
        {
          "name": "세무 데이터 삭제",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/data/{{userId}}/1",
              "host": ["{{baseUrl}}"],
              "path": ["data", "{{userId}}", "1"]
            }
          }
        },
        {
          "name": "더미 데이터(Mock) 생성",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startMon\": \"2026-01\",\n  \"endMon\": \"2026-06\",\n  \"count\": 20,\n  \"type\": \"SALES\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/data/generate/mock/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["data", "generate", "mock", "{{userId}}"]
            }
          }
        },
        {
          "name": "업로드 양식(format.csv) 다운로드",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/data/download/format",
              "host": ["{{baseUrl}}"],
              "path": ["data", "download", "format"]
            }
          }
        },
        {
          "name": "카드 내역 업로드 (배치 큐 등록)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/card_history.csv"
                },
                {
                  "key": "cardNum",
                  "value": "1234-5678-9012-3456",
                  "type": "text"
                },
                {
                  "key": "startMon",
                  "value": "2026-01",
                  "type": "text"
                },
                {
                  "key": "endMon",
                  "value": "2026-06",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/data/upload/card/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["data", "upload", "card", "{{userId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Report (세금 리포트 관리)",
      "item": [
        {
          "name": "리포트 통합 조회",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reports/get/{{userId}}?reportType=VAT&endMon=2026-06",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "get", "{{userId}}"],
              "query": [
                { "key": "reportType", "value": "VAT" },
                { "key": "endMon", "value": "2026-06" }
              ]
            }
          }
        },
        {
          "name": "기납부세액 조회",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reports/prepaid-tax/{{userId}}?reportType=VAT&endMon=2026-06",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "prepaid-tax", "{{userId}}"],
              "query": [
                { "key": "reportType", "value": "VAT" },
                { "key": "endMon", "value": "2026-06" }
              ]
            }
          }
        },
        {
          "name": "기납부세액 수정 반영",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reportType\": \"VAT\",\n  \"endMon\": \"2026-06\",\n  \"prepaidTax\": 500000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reports/update/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "update", "{{userId}}"]
            }
          }
        },
        {
          "name": "리포트 갱신",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reportType\": \"VAT\",\n  \"endMon\": \"2026-06\",\n  \"prepaidTax\": 500000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reports/refresh/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "refresh", "{{userId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Batch (배치 제어 및 모니터링)",
      "item": [
        {
          "name": "job 등록1: 사업자 상태 업데이트",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/batch/job/statusUpdateJob",
              "host": ["{{baseUrl}}"],
              "path": ["batch", "job", "statusUpdateJob"]
            }
          }
        },
        {
          "name": "job 등록2: 사업자 상태 마감",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/batch/job/statusClosedJob",
              "host": ["{{baseUrl}}"],
              "path": ["batch", "job", "statusClosedJob"]
            }
          }
        },
        {
          "name": "job 등록3: 월간/누적 리포트 생성",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/batch/job/reportCreateJob?endMon=2026-10",
              "host": ["{{baseUrl}}"],
              "path": ["batch", "job", "reportCreateJob"],
              "query": [
                { "key": "endMon", "value": "2026-10" }
              ]
            }
          }
        },
        {
          "name": "job 등록4: 지난 세율 데이터 삭제",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/batch/job/rateDeleteJob",
              "host": ["{{baseUrl}}"],
              "path": ["batch", "job", "rateDeleteJob"]
            }
          }
        },
        {
          "name": "job 등록5: 세무 데이터 마감",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/batch/job/dataClosedJob",
              "host": ["{{baseUrl}}"],
              "path": ["batch", "job", "dataClosedJob"]
            }
          }
        },
        {
          "name": "캐시 초기화 (세율 및 업종명)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/batch/cache",
              "host": ["{{baseUrl}}"],
              "path": ["batch", "cache"]
            }
          }
        },
        {
          "name": "좀비 큐 롤백 (장애 복구)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/batch/queue/reap",
              "host": ["{{baseUrl}}"],
              "path": ["batch", "queue", "reap"]
            }
          }
        },
        {
          "name": "사용자별 배치 대기열 조회",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/batch/queue/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["batch", "queue", "{{userId}}"]
            }
          }
        },
        {
          "name": "전체 배치 대기열 조회",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/batch/queue",
              "host": ["{{baseUrl}}"],
              "path": ["batch", "queue"]
            }
          }
        },
        {
          "name": "배치 파일 데이터 미리보기",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/batch/queue/detail/1",
              "host": ["{{baseUrl}}"],
              "path": ["batch", "queue", "detail", "1"]
            }
          }
        }
      ]
    }
  ]
}